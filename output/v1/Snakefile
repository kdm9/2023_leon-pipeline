# collapsing strict

rule collapse_pb_strict:
    input:
        "output/mapping_pb/{sample}.mapped.bam"
    output:
        "output/v1/collapse_pb/{sample}.collapsed.pb.v1.gff"
    log:
        "log/collapse_pb/{sample}.collapse.v1.log"
    threads: 4
    params:
        v1="--max-fuzzy-junction 0 --max-5p-diff 0 --max-3p-diff 0"
    priority: 50
    shell:
        "mkdir -p output/v1/collapse_pb && isoseq3 collapse --do-not-collapse-extra-5exons {params.v1} --log-level INFO --log-file {log} -j {threads} {input} {output}"

rule collapse_stringtie_strict:
    input:
        "output/mapping_minimap/{sample}.mapped.bam"
    output:
        "output/v1/collapse_stringtie/{sample}.collapsed.stringtie.v1.gff"
    log:
        "log/collapse_stringtie/{sample}.collapsed.v1.log"
    params:
        v1="-t -L -R -E 0"
    priority: 50
    shell:
        "mkdir -p output/v1/collapse_stringtie && stringtie {params.v1} -o {output} {input} |& tee {log}"

rule collapse_tama_strict:
    input:
        mapping="output/mapping_minimap/{sample}.mapped.bam",
        fasta="input/refs/{sample}.scaffolds-v2.3.fasta"
    output:
        "output/v1/collapse_tama/{sample}.collapsed.tama.v1.bed"
    log:
        "log/collapse_tama/{sample}.collapse.v1.bed.log"
    params:
        python_path="~/anaconda3/envs/py2.7/bin/python2.7",
        tama_path="~/software/tama/tama_collapse.py",
        prefix="output/v1/collapse_tama/{sample}.collapsed.tama.v1",
        v1="-x capped -a 10 -m 0 -z 5"
    shell:
        "mkdir -p output/collapse_tama && {params.python_path} {params.tama_path} -s {input.mapping} -b BAM -f {input.fasta} -p {params.prefix} {params.v1} -log log_off |& tee {log}"

rule bed2gtf_strict:
    input:
        "output/v1/collapse_tama/{sample}.collapsed.tama.v1.bed"
    output:
        "output/v1/collapse_tama/{sample}.collapsed.tama.v1.gtf"
    log:
        "log/collapse_tama/{sample}.collapsed.tama.v1.gtf.log"
    shell:
        "perl scripts/bed12ToGTF.1.pl < {input} > {output} |& tee {log}"

rule gtf2gff3_strict:
    input:
        "output/v1/collapse_tama/{sample}.collapsed.tama.v1.gtf"
    output:
        "output/v1/collapse_tama/{sample}.collapsed.tama.v1.gff3"
    log:
        "log/collapse_tama/{sample}.collapsed.tama.v1.gff3.log"
    shell:
        "gffread -E --keep-genes {input} -o {output} |& tee {log}"

