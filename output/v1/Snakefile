# collapsing v2

rule collapse_pb_v2:
    input:
        "output/mapping_pb/{sample}.mapped.bam"
    output:
        "output/v2/collapse_pb/{sample}.collapsed.pb.v2.gff"
    log:
        "log/collapse_pb/{sample}.collapse.v2.log"
    threads: 4
    params:
        v1="--min-aln-identity 0.99 --max-fuzzy-junction 0 --max-5p-diff 10 --max-3p-diff 5"
    priority: 50
    shell:
        "mkdir -p output/v2/collapse_pb && isoseq3 collapse --do-not-collapse-extra-5exons {params.v1} --log-level INFO --log-file {log} -j {threads} {input} {output}"

rule collapse_stringtie_v2:
    input:
        "output/mapping_minimap/{sample}.mapped.bam"
    output:
        "output/v2/collapse_stringtie/{sample}.collapsed.stringtie.v2.gff"
    log:
        "log/collapse_stringtie/{sample}.collapsed.v3.log"
    params:
        v2="-s 0.99 -g -20 -t -R -E 10",
        stats="output/v3/collapse_stringtie/{sample}.collapsed.stringtie.v3.stats"
    priority: 50
    shell:
        "mkdir -p output/v1/collapse_stringtie && /ebio/abt6/lvaness/software/stringtie/stringtie {params.v2} -A {params.stats} -o {output} {input} |& tee {log}"

rule collapse_tama_v2:
    input:
        mapping="output/mapping_minimap/{sample}.mapped.bam",
        fasta="input/refs/{sample}.scaffolds-v2.3.fasta"
    output:
        "output/v2/collapse_tama/{sample}.collapsed.tama.v2.bed"
    log:
        "log/collapse_tama/{sample}.collapse.v2.bed.log"
    params:
        python_path="~/anaconda3/envs/py2.7/bin/python2.7",
        tama_path="~/software/tama/tama_collapse.py",
        prefix="output/v2/collapse_tama/{sample}.collapsed.tama.v2",
        v="-x capped -a 10 -m 0 -z 5 -i 99 -sj sj_priority -sjt 10 -lde 2"
    shell:
        "mkdir -p output/v2/collapse_tama && {params.python_path} {params.tama_path} -s {input.mapping} -b BAM -f {input.fasta} -p {params.prefix} {params.v} -log log_off |& tee {log}"

rule bed2gtf_v2:
    input:
        "output/v2/collapse_tama/{sample}.collapsed.tama.v2.bed"
    output:
        "output/v2/collapse_tama/{sample}.collapsed.tama.v2.gtf"
    log:
        "log/collapse_tama/{sample}.collapsed.tama.v2.gtf.log"
    shell:
        "perl scripts/bed12ToGTF.1.pl < {input} > {output} |& tee {log}"

