configfile: "config.yaml"

rename_in = []
rename_out = []
refine_out = []
rename_rg_out = []
concat_out = []
cluster_out = []


for idx, pool in enumerate(config['pools']):
    for bc, sample in zip(config['name2bc'][idx].values(), config['name2bc'][idx].keys()):
        rename_in.append(f"{pool}/{pool}.demux.hifi.{bc}.bam")
        rename_out.append(f"{pool}/{pool}.demux.hifi.{sample}.bam")
        refine_out.append(f"{pool}/{pool}.{sample}.ncfl.bam")
        rename_rg_out.append(f"{pool}/{pool}.{sample}.ncfl.bam")
        concat_out.append(f"{sample}.ncfl.fastq")
        cluster_out.append(f"{sample}.transcripts.bam")

# CCS

rule all:
    input:
        expand("output/lima/{pattern}", pattern=rename_out),
        expand("output/refine/{pattern}", pattern=refine_out),
        expand("output/rename_rg/{pattern}", pattern=rename_rg_out),
        expand("output/concat_samples/{pattern}", pattern=concat_out),
        # expand("output/cluster/{pattern}", pattern=cluster_out),
        expand("output/mapping_minimap/{sample}.mapped.bam.bai", sample=config["samples2map"]),
        expand("output/v0/collapse_pb/{sample}.collapsed.pb.v0.gff", sample=config["samples2map"]),
        expand("output/v0/collapse_stringtie/{sample}.collapsed.stringtie.v0.gff", sample=config["samples2map"]),
        expand("output/v0/collapse_tama/{sample}.collapsed.tama.v0.bed", sample=config["samples2map"]),
        expand("output/v0/collapse_tama/{sample}.collapsed.tama.v0.gff3", sample=config["samples2map"]),
        expand("output/v0/merged_gff/{sample}.merged.v0.gff", sample=config["samples2map"]),
        ### collapsing v1
        expand("output/v1/collapse_pb/{sample}.collapsed.pb.v1.gff", sample=config["samples2map"]),
        expand("output/v1/collapse_stringtie/{sample}.collapsed.stringtie.v1.gff", sample=config["samples2map"]),
        expand("output/v1/collapse_tama/{sample}.collapsed.tama.v1.bed", sample=config["samples2map"]),
        expand("output/v1/collapse_tama/{sample}.collapsed.tama.v1.gff3", sample=config["samples2map"]),
        ### collapsing v2
        expand("output/v2/collapse_pb/{sample}.collapsed.pb.v2.gff", sample=config["samples2map"]),
        expand("output/v2/collapse_stringtie/{sample}.collapsed.stringtie.v2.gff", sample=config["samples2map"]),
        expand("output/v2/collapse_tama/{sample}.collapsed.tama.v2.bed", sample=config["samples2map"]),
        expand("output/v2/collapse_tama/{sample}.collapsed.tama.v2.gff3", sample=config["samples2map"])



